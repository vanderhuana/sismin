// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  rol       RolUsuario @default(MODERADO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  internaciones   Internacion[]
  anticipos       Anticipo[]
  ventasGenerales VentaLoteGeneral[]

  @@map("usuarios")
}

model Proveedor {
  id             Int      @id @default(autoincrement())
  nombreCompleto String   @db.VarChar(200)
  ci             String?  @unique @db.VarChar(20)
  telefono       String?  @db.VarChar(20)
  direccion      String?  @db.Text
  tipo           TipoProveedor @default(PERSONA_NATURAL)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  internaciones Internacion[]
  anticipos     Anticipo[]

  @@map("proveedores")
}

model Internacion {
  id                Int      @id @default(autoincrement())
  lote              String   @unique // Auto-generado: formato LOTE-001, LOTE-002, etc.
  fechaInternacion  DateTime @default(now())
  tipoMineral       TipoMineral
  kilosBruto        Decimal  @db.Decimal(10,3)
  estado            EstadoInternacion @default(EN_ESPERA_LEY)
  anticipo          Decimal  @default(0) @db.Decimal(10,2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Foreign Keys
  proveedorId       Int
  usuarioId         Int      // Usuario que registró la internación

  // Relaciones
  proveedor         Proveedor @relation(fields: [proveedorId], references: [id])
  usuario           Usuario   @relation(fields: [usuarioId], references: [id])
  calculo           Calculo?
  anticipos         Anticipo[]
  ventaDetalles     VentaLoteDetalle[]

  @@map("internaciones")
}

model Calculo {
  id                    Int      @id @default(autoincrement())
  fechaCalculo          DateTime @default(now())
  tipoMineral           TipoMineral
  
  // Campos para PLATA y PLOMO (mineral simple)
  ley                   Decimal? @db.Decimal(10,3)
  valorEscala           Decimal? @db.Decimal(10,2)
  
  // Campos para COMPLEJO (doble mineral)
  leyPlata              Decimal? @db.Decimal(10,3)
  valorEscalaPlata      Decimal? @db.Decimal(10,2)
  leyPlomo              Decimal? @db.Decimal(10,3)
  valorEscalaPlomo      Decimal? @db.Decimal(10,2)
  valorEscalaTotal      Decimal? @db.Decimal(10,2)
  
  // Campos de cálculo
  humedadPorcentaje     Decimal  @db.Decimal(5,2)
  kilosNeto             Decimal  @db.Decimal(10,3) // Calculado
  valorBruto            Decimal  @db.Decimal(12,2) // Calculado
  regaliasPorcentaje    Decimal  @default(10) @db.Decimal(5,2)
  regaliasMonto         Decimal  @db.Decimal(12,2) // Calculado
  anticipos             Decimal  @default(0) @db.Decimal(10,2) // Total de anticipos (báscula + proveedor)
  anticipoBascula       Decimal  @default(0) @db.Decimal(10,2) // Anticipo registrado en báscula
  anticipoProveedor     Decimal  @default(0) @db.Decimal(10,2) // Anticipo descontado de cuenta
  transporte            Decimal  @default(0) @db.Decimal(10,2)
  saldoFinal            Decimal  @db.Decimal(12,2) // Calculado
  
  // Estado
  estadoPago            EstadoPago @default(PENDIENTE)
  fechaPago             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Foreign Key
  internacionId         Int      @unique

  // Relaciones
  internacion           Internacion @relation(fields: [internacionId], references: [id])
  descuentosAnticipo    AnticipoDescuento[]

  @@map("calculos")
}

model Anticipo {
  id                Int                 @id @default(autoincrement())
  codigoVale        String?             @unique @db.VarChar(50)
  monto             Decimal             @db.Decimal(10,2)
  saldoPendiente    Decimal             @default(0) @db.Decimal(10,2)
  estado            EstadoAnticipo      @default(PENDIENTE)
  fecha             DateTime            @default(now())
  observacion       String?             @db.Text
  glosa             String?             @db.VarChar(255)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Foreign Keys
  internacionId     Int?
  proveedorId       Int?
  usuarioId         Int?

  // Relaciones
  internacion       Internacion?        @relation(fields: [internacionId], references: [id], onDelete: Cascade)
  proveedor         Proveedor?          @relation(fields: [proveedorId], references: [id])
  usuario           Usuario?            @relation(fields: [usuarioId], references: [id])
  descuentos        AnticipoDescuento[]

  @@map("anticipos")
}

model AnticipoDescuento {
  id              Int       @id @default(autoincrement())
  anticipoId      Int
  calculoId       Int
  montoDescontado Decimal   @db.Decimal(10,2)
  fecha           DateTime  @default(now())

  anticipo        Anticipo  @relation(fields: [anticipoId], references: [id], onDelete: Cascade)
  calculo         Calculo   @relation(fields: [calculoId], references: [id], onDelete: Cascade)

  @@map("anticipos_descuentos")
}

model VentaLoteGeneral {
  id                    Int       @id @default(autoincrement())
  numeroLoteGeneral     String    @unique
  fecha                 DateTime  @default(now())
  fechaInicioFiltro     DateTime?
  fechaFinFiltro        DateTime?
  tipoMineral           TipoMineral
  leyReferenciaAg       Decimal?  @db.Decimal(10,3)
  leyReferenciaPb       Decimal?  @db.Decimal(10,3)
  
  // Totales calculados
  totalPesoNeto         Decimal   @db.Decimal(12,3)
  totalPromedioAg       Decimal?  @db.Decimal(14,3)
  totalPromedioPb       Decimal?  @db.Decimal(14,3)
  leyPonderadaAg        Decimal?  @db.Decimal(10,4)
  leyPonderadaPb        Decimal?  @db.Decimal(10,4)
  costoTotalCompra      Decimal?  @db.Decimal(14,2)
  
  observaciones         String?   @db.Text
  estado                String    @default("CERRADO")
  
  usuarioId             Int?
  usuario               Usuario?  @relation(fields: [usuarioId], references: [id])
  
  detalles              VentaLoteDetalle[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("ventas_lote_general")
}

model VentaLoteDetalle {
  id                    Int              @id @default(autoincrement())
  ventaId               Int
  internacionId         Int?
  
  numeroLote            String
  pesoNeto              Decimal          @db.Decimal(12,3)
  leyAg                 Decimal?         @db.Decimal(10,3)
  promedioAg            Decimal?         @db.Decimal(14,3)
  leyPb                 Decimal?         @db.Decimal(10,3)
  promedioPb            Decimal?         @db.Decimal(14,3)
  costoCompra           Decimal?         @db.Decimal(12,2)
  
  venta                 VentaLoteGeneral @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  internacion           Internacion?     @relation(fields: [internacionId], references: [id])
  
  createdAt             DateTime         @default(now())

  @@map("ventas_lote_detalles")
}

// Enums
enum RolUsuario {
  ADMIN
  MODERADO
}

enum TipoProveedor {
  EMPRESA
  PERSONA_NATURAL
}

enum TipoMineral {
  PLATA
  PLOMO
  COMPLEJO
}

enum EstadoInternacion {
  EN_ESPERA_LEY
  CALCULADO
  PAGADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
}

enum EstadoAnticipo {
  PENDIENTE
  PARCIAL
  COBRADO
  ANULADO
}
